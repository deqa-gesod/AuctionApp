<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#C2185B" /> <!-- Darker shade for pressed state -->
            <corners android:radius="30dp" />
        </shape>
    </item>

    <!-- Focused (hover) state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#E91E63" /> <!-- Slightly lighter shade for hover -->
            <corners android:radius="30dp" />
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D81B60" /> <!-- Default color -->
            <corners android:radius="30dp" />
        </shape>
    </item>
</selector>
