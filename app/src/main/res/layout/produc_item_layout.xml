<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/product_item_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:backgroundTint="@color/activeColor"
    app:cardCornerRadius="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <androidx.cardview.widget.CardView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:paddingStart="20dp"
            app:cardCornerRadius="20dp">

            <ImageView
                android:id="@+id/ivProductImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="#921C46"
                android:clipToOutline="true"
                android:outlineProvider="background"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="vertical"
            android:paddingStart="17dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="5dp"
                android:background="@color/activeColor"
                android:fontFamily="@font/montserratextrabold"
                android:textColor="@color/white"
                android:textSize="21sp"
                />

            <!-- Deadline Label -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDeadlineLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deadline: "
                    android:textColor="@color/white"
                    android:textSize="17sp" />

                <!-- Add an empty space (1dp) between Deadline and tvProductDescription -->

                <TextView
                    android:id="@+id/tvDeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/activeColor"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#F0F6D710"
                    android:textSize="16sp"
                    tools:visibility="invisible" />

            </LinearLayout>

            <!-- Initial Price Label and Contact Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvInitialPriceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Price: "
                    android:textColor="@color/white"
                    android:textSize="17sp" />


                <TextView
                    android:id="@+id/tvContactInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:background="@color/activeColor"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    tools:visibility="invisible"
                    tools:ignore="TextViewEdits" />

                <TextView
                    android:layout_width="4dp"
                    android:layout_height="8dp"
                    />

                <TextView
                    android:id="@+id/selectedCurrency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/activeColor"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    tools:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>