<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:backgroundTint="@color/activeColor"
    app:cardCornerRadius="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">


        <androidx.cardview.widget.CardView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:paddingStart="20dp"
            app:cardCornerRadius="20dp">

            <ImageView
                android:id="@+id/offer_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/activeColor"
                android:layout_gravity="center"
                android:clipToOutline="true"
                android:outlineProvider="background"
                android:scaleType="centerCrop"
                tools:srcCompat="@tools:sample/avatars" />

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="219dp"
            android:layout_height="147dp"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/offer_name"
                android:layout_width="match_parent"
                android:layout_marginTop="5dp"
                android:layout_height="86dp"
                android:layout_marginStart="20sp"
                android:fontFamily="@font/montserratextrabold"
                android:textColor="@color/white"
                android:textSize="21sp"
                tools:text="Offer Name" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/offer_name"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/offer_edit_button"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/white"
                    android:fontFamily="@font/montserratextrabold"
                    android:text="New Bid"
                    android:textColor="@color/activeColor" />

                <Button
                    android:id="@+id/offer_delete_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/white"
                    android:layout_toEndOf="@id/offer_edit_button"
                    android:fontFamily="@font/montserratextrabold"
                    android:text="Drop"
                    android:textColor="@color/activeColor" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
